cabal-version:      2.4
name:               torneio-stats
version:            0.1.0.0
synopsis:           Estatísticas individuais de jogadores num torneio de 8 equipas
build-type:         Simple

library
    exposed-modules:  Model
                    , Stats
                    , Torneio
                    , DadosTeste
    hs-source-dirs:   src
    build-depends:    base >=4 && <5
    default-language: Haskell2010
    ghc-options:      -Wall

executable torneio-stats
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4 && <5
                    , torneio-stats
    default-language: Haskell2010
    ghc-options:      -Wall
